{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-probe/types/**/*.ts",
    ".next-probe/dev/types/**/*.ts",
    ".next-a9/types/**/*.ts",
    ".next-a9/dev/types/**/*.ts",
    ".next-a8/types/**/*.ts",
    ".next-a8/dev/types/**/*.ts",
    ".next-a10/types/**/*.ts",
    ".next-a10/dev/types/**/*.ts",
    ".next-a11/types/**/*.ts",
    ".next-a11/dev/types/**/*.ts",
    ".next-a12/types/**/*.ts",
    ".next-a12/dev/types/**/*.ts",
    ".next-a13/types/**/*.ts",
    ".next-a13/dev/types/**/*.ts",
    ".next-a14/types/**/*.ts",
    ".next-a14/dev/types/**/*.ts",
    ".next-a15/types/**/*.ts",
    ".next-a15/dev/types/**/*.ts",
    ".next-a16/types/**/*.ts",
    ".next-a16/dev/types/**/*.ts",
    ".next-a17/types/**/*.ts",
    ".next-a17/dev/types/**/*.ts",
    ".next-a18/types/**/*.ts",
    ".next-a18/dev/types/**/*.ts",
    ".next-a19/types/**/*.ts",
    ".next-a19/dev/types/**/*.ts",
    ".next-a20/types/**/*.ts",
    ".next-a20/dev/types/**/*.ts",
    ".next-a21/types/**/*.ts",
    ".next-a21/dev/types/**/*.ts",
    ".next-a22/types/**/*.ts",
    ".next-a22/dev/types/**/*.ts",
    ".next-a23/types/**/*.ts",
    ".next-a23/dev/types/**/*.ts",
    ".next-a24/types/**/*.ts",
    ".next-a24/dev/types/**/*.ts",
    ".next-a25/types/**/*.ts",
    ".next-a25/dev/types/**/*.ts",
    ".next-a26/types/**/*.ts",
    ".next-a26/dev/types/**/*.ts",
    ".next-a27/types/**/*.ts",
    ".next-a27/dev/types/**/*.ts",
    ".next-a28/types/**/*.ts",
    ".next-a28/dev/types/**/*.ts",
    ".next-a29/types/**/*.ts",
    ".next-a29/dev/types/**/*.ts",
    ".next-a30/types/**/*.ts",
    ".next-a30/dev/types/**/*.ts",
    ".next-a31/types/**/*.ts",
    ".next-a31/dev/types/**/*.ts",
    ".next-a32/types/**/*.ts",
    ".next-a32/dev/types/**/*.ts",
    ".next-a33/types/**/*.ts",
    ".next-a33/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
